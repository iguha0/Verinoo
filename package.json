{
  "name": "ai-chain-network",
  "version": "0.1.0",
  "description": "AI-native decentralized blockchain network",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/wasm/inference.wasm dist/wasm/inference.wasm",
    "start": "node dist/cli/index.js",
    "test": "node --test --test-force-exit \"dist/**/*.test.js\"",
    "node1": "node dist/cli/index.js start --name=node1 --port=3001 --p2p=5001 --db=./data/node1 --validator",
    "node2": "node dist/cli/index.js start --name=node2 --port=3002 --p2p=5002 --db=./data/node2 --peers=ws://127.0.0.1:5001",
    "node3": "node dist/cli/index.js start --name=node3 --port=3003 --p2p=5003 --db=./data/node3 --peers=ws://127.0.0.1:5001,ws://127.0.0.1:5002"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.10",
    "circom": "^0.5.46",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "snarkjs": "^0.7.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "wabt": "^1.0.39",
    "ws": "^8.16.0"
  }
}

# /etc/ainative/node1.env  — validator (first node)
AIN_PORT=3001
AIN_P2P=5001
AIN_DB=/var/lib/ainative/node1
AIN_EXTRA=--validator

# /etc/ainative/node2.env — peer, discovers node1
# AIN_PORT=3002
# AIN_P2P=5002
# AIN_DB=/var/lib/ainative/node2
# AIN_EXTRA=--peers=ws://127.0.0.1:5001

# /etc/ainative/node3.env — peer, discovers node1+node2
# AIN_PORT=3003
# AIN_P2P=5003
# AIN_DB=/var/lib/ainative/node3
# AIN_EXTRA=--peers=ws://127.0.0.1:5001,ws://127.0.0.1:5002
